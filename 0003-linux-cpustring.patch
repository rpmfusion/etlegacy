From a5ee17977113b5e402593baef7b792af796753ae Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Trung=20L=C3=AA?= <8@tle.id.au>
Date: Fri, 13 Nov 2026 23:05:26 +1100
Subject: [PATCH] qcommon: name the architecture in the Linux CPUSTRING

Linux architectures other than i386, x86_64, alpha, arm and aarch64 showed up
as linux-other in the version string. Use ARCH_STRING for them, so ppc64le
for example shows as linux-ppc64le.
---
 src/qcommon/q_shared.h | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/qcommon/q_shared.h b/src/qcommon/q_shared.h
index 688038d94..95bd0b353 100644
--- a/src/qcommon/q_shared.h
+++ b/src/qcommon/q_shared.h
@@ -297,6 +297,8 @@ static ID_INLINE float idSqrt(float x)
 #define CPUSTRING   "linux-arm"
 #elif defined __aarch64__
 #define CPUSTRING   "linux-aarch64"
+#elif defined ARCH_STRING
+#define CPUSTRING   "linux-" ARCH_STRING
 #else
 #define CPUSTRING   "linux-other"
 #endif
