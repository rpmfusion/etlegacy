@@ -269,34 +276,27 @@ CHANNEL MIXING
  */
 static void S_PaintChannelFrom16_altivec(channel_t *ch, const sfx_t *sc, int count, int sampleOffset, int bufferOffset)
 {
-	int                   data, aoff, boff;
+	int                   data;
 	int                   leftvol, rightvol;
-	int                   i, j;
